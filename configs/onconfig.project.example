# Project-specific ONCONFIG parameter reference.
# This is intentionally NOT a complete onconfig.std file.
# Start from the configuration template supplied with your licensed Informix
# installation and review the parameters below for your own environment.

ROOTNAME        rootdbs
ROOTPATH        /opt/IBM/ifmxdata/ol_demo/rootdbs_dat.000
ROOTOFFSET      0
ROOTSIZE        400000

# Initial physical/logical log values from the source environment.
# Final sizing must be calculated for the target workload.
PHYSFILE        32000
LOGFILES        5
LOGSIZE         10000

SERVERNUM       0
DBSERVERNAME    ol_demo

NETTYPE         ipcshm,1,50,CPU
NETTYPE         soctcp,2,50,NET

DBSPACETEMP     dbs_temp

MSGPATH         $INFORMIXDIR/tmp/online.log
CONSOLE         $INFORMIXDIR/tmp/online.con
